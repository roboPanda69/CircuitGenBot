    "OpenArchitectureDecision": {
      "additionalProperties": false,
      "properties": {
        "affected_blocks": {
          "items": {
            "type": "string"
          },
          "title": "Affected Blocks",
          "type": "array"
        },
        "blocking": {
          "title": "Blocking",
          "type": "boolean"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "open_decision_id": {
          "title": "Open Decision Id",
          "type": "string"
        },
        "options": {
          "items": {
            "$ref": "#/$defs/ArchitectureChoice"
          },
          "title": "Options",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/OpenDecisionStatus",
          "default": "open"
        },
        "topic": {
          "title": "Topic",
          "type": "string"
        }
