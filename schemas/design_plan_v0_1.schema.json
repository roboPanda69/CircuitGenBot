        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "participants": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Participants",
          "type": "array"
        },
        "power_domain": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
