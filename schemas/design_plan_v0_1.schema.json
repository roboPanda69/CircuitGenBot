      "type": "string"
    },
    "PortDirection": {
      "enum": [
        "input",
        "output",
        "bidirectional"
      ],
      "title": "PortDirection",
      "type": "string"
    },
    "PowerDomain": {
      "additionalProperties": false,
      "properties": {
        "consumer_blocks": {
          "items": {
            "type": "string"
          },
          "title": "Consumer Blocks",
          "type": "array"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "power_domain_id": {
          "title": "Power Domain Id",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/PowerDomainRole"
        },
        "source_block": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Block"
        },
        "voltage": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "boolean": "#/$defs/BooleanConstraint",
                  "enum": "#/$defs/EnumConstraint",
                  "enum_preference": "#/$defs/EnumPreferenceConstraint",
                  "exact": "#/$defs/ExactConstraint",
                  "maximum": "#/$defs/MaximumConstraint",
                  "minimum": "#/$defs/MinimumConstraint",
                  "nominal": "#/$defs/NominalConstraint",
                  "nominal_with_tolerance": "#/$defs/NominalWithToleranceConstraint",
                  "range": "#/$defs/RangeConstraint",
                  "text": "#/$defs/TextConstraint"
                },
                "propertyName": "kind"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/ExactConstraint"
                },
                {
                  "$ref": "#/$defs/NominalConstraint"
                },
                {
                  "$ref": "#/$defs/MinimumConstraint"
                },
                {
                  "$ref": "#/$defs/MaximumConstraint"
                },
                {
                  "$ref": "#/$defs/RangeConstraint"
                },
                {
                  "$ref": "#/$defs/BooleanConstraint"
                },
                {
                  "$ref": "#/$defs/EnumConstraint"
                },
                {
                  "$ref": "#/$defs/EnumPreferenceConstraint"
                },
                {
                  "$ref": "#/$defs/TextConstraint"
                },
                {
                  "$ref": "#/$defs/NominalWithToleranceConstraint"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Voltage"
        }
      },
      "required": [
        "power_domain_id",
        "name",
        "role"
      ],
      "title": "PowerDomain",
      "type": "object"
    },
    "PowerDomainRole": {
      "enum": [
        "input",
        "protected_input",
        "regulated_output",
        "unregulated",
        "logic_supply",
        "analog_supply",
        "reference",
        "isolated_supply",
        "other"
      ],
      "title": "PowerDomainRole",
      "type": "string"
    },
    "RangeConstraint": {
