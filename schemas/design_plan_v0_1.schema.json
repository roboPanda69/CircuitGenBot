      },
      "required": [
        "assumption_id",
        "description",
        "impact"
      ],
      "title": "DesignAssumption",
      "type": "object"
    },
    "DesignPlanMetadata": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "title": "Created By",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
