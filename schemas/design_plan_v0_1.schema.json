      "additionalProperties": false,
      "properties": {
        "minus": {
          "minimum": 0,
          "title": "Minus",
          "type": "number"
        },
        "plus": {
          "minimum": 0,
          "title": "Plus",
          "type": "number"
        },
        "type": {
