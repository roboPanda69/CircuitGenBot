      "enum": [
        "switching_step_down",
        "switching_step_up",
        "switching_inverting",
        "linear_regulation",
        "isolated_power_conversion",
        "non_isolated_power_conversion",
        "direct_interface",
        "interface_bridge",
        "analog_filter",
        "amplifier",
        "signal_conditioning",
        "level_translation",
        "galvanic_isolation",
        "sensor_frontend",
        "actuator_driver",
        "protocol_translation",
        "single_rail",
        "multiple_rails",
        "centralized_regulation",
        "distributed_regulation",
        "isolated_domains",
        "shared_ground_domains",
        "galvanically_isolated",
        "non_isolated",
        "partial_isolation",
        "direct_signal_path",
        "filtered_signal_path",
        "amplified_signal_path",
        "conditioned_signal_path",
        "differential_signal_path",
        "single_ended_signal_path",
        "single_board_partition",
        "modular_partition",
        "separate_power_and_control",
        "integrated_architecture",
        "custom_architecture"
