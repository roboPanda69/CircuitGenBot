      "items": {
        "$ref": "#/$defs/ArchitectureDecision"
      },
      "title": "Architecture Decisions",
      "type": "array"
    },
    "assumptions": {
      "items": {
        "$ref": "#/$defs/DesignAssumption"
      },
      "title": "Assumptions",
      "type": "array"
    },
