      "enum": [
        "mapped",
        "partially_mapped",
        "unresolved",
        "not_applicable"
      ],
      "title": "RequirementMappingStatus",
      "type": "string"
    },
    "SourceRequirementSet": {
      "additionalProperties": false,
      "properties": {
        "requirement_set_id": {
          "title": "Requirement Set Id",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
