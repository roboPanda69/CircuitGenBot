          "type": "integer"
        }
      },
      "required": [
        "requirement_set_id",
        "revision"
      ],
      "title": "SourceRequirementSet",
      "type": "object"
    },
    "TextConstraint": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "text",
          "default": "text",
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "TextConstraint",
      "type": "object"
    },
