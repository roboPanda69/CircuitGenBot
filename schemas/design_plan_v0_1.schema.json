          "type": "string"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "title": "ExactConstraint",
      "type": "object"
    },
    "FunctionalBlock": {
      "additionalProperties": false,
      "properties": {
        "block_id": {
          "title": "Block Id",
          "type": "string"
        },
        "inputs": {
          "items": {
            "$ref": "#/$defs/FunctionalPort"
          },
          "title": "Inputs",
          "type": "array"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "outputs": {
          "items": {
            "$ref": "#/$defs/FunctionalPort"
          },
          "title": "Outputs",
          "type": "array"
