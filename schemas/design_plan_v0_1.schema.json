      "type": "object"
    },
    "EnumPreferenceConstraint": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "enum_preference",
          "default": "enum_preference",
          "title": "Kind",
          "type": "string"
        },
        "preferred": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Preferred",
          "type": "array"
        }
