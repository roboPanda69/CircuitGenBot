          "title": "Unit",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "title": "NominalConstraint",
      "type": "object"
    },
    "NominalWithToleranceConstraint": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "nominal_with_tolerance",
