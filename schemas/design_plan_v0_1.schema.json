            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        }
      },
      "required": [
        "type",
        "minus",
        "plus"
      ],
      "title": "Tolerance",
      "type": "object"
