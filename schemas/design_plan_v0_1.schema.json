        "rationale": {
          "title": "Rationale",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ArchitectureDecisionStatus",
          "default": "proposed"
        },
        "target": {
          "$ref": "#/$defs/MappingTarget"
        },
        "type": {
          "$ref": "#/$defs/ArchitectureDecisionType"
        }
      },
      "required": [
        "decision_id",
        "type",
        "target",
