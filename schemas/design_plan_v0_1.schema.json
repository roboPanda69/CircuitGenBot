        "isolated_power_conversion",
        "non_isolated_power_conversion",
        "direct_interface",
        "interface_bridge",
        "analog_filter",
        "amplifier",
        "signal_conditioning",
        "level_translation",
        "galvanic_isolation",
        "sensor_frontend",
