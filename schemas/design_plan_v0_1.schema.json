    "DesignAssumption": {
      "additionalProperties": false,
      "properties": {
        "affected_blocks": {
          "items": {
            "type": "string"
          },
          "title": "Affected Blocks",
          "type": "array"
        },
        "assumption_id": {
          "title": "Assumption Id",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "impact": {
          "$ref": "#/$defs/Impact"
