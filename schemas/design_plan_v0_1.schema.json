          "title": "Implemented By",
          "type": "array"
        },
        "mapping_id": {
          "title": "Mapping Id",
          "type": "string"
        },
        "requirement_id": {
          "title": "Requirement Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/RequirementMappingStatus"
        }
      },
      "required": [
        "mapping_id",
